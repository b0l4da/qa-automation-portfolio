{
  "info": {
    "name": "Restful Booker - QA Portfolio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://restful-booker.herokuapp.com" },
    { "key": "token", "value": "" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Gerar token",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Retorna token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
        "pm.collectionVariables.set('token', pm.response.json().token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/auth"
      }
    },
    {
      "name": "2. Criar reserva",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "const j = pm.response.json();",
        "pm.test('Nome correto', () => pm.expect(j.booking.firstname).to.eql('Flavia'));",
        "pm.test('Tempo de resposta < 3s', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
        "pm.collectionVariables.set('bookingId', j.bookingid);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstname\": \"Flavia\",\n  \"lastname\": \"Fernandes\",\n  \"totalprice\": 1500,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-12-27\", \"checkout\": \"2027-01-03\" },\n  \"additionalneeds\": \"Breakfast\"\n}" },
        "url": "{{baseUrl}}/booking"
      }
    },
    {
      "name": "3. Consultar reserva",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 200', () => pm.response.to.have.status(200));",
        "pm.test('Sobrenome correto', () => pm.expect(pm.response.json().lastname).to.eql('Fernandes'));"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": "{{baseUrl}}/booking/{{bookingId}}" }
    },
    {
      "name": "4. Excluir sem token (negativo)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 403', () => pm.response.to.have.status(403));"
      ] } }],
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/booking/{{bookingId}}" }
    },
    {
      "name": "5. Excluir com token",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status 201', () => pm.response.to.have.status(201));"
      ] } }],
      "request": { "method": "DELETE", "header": [{ "key": "Cookie", "value": "token={{token}}" }], "url": "{{baseUrl}}/booking/{{bookingId}}" }
    }
  ]
}
